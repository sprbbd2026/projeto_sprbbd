{
  "info": {
    "name": "TS1 Back API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operador@teste.com\",\n  \"password\": \"Operador@123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Operadores",
      "item": [
        {
          "name": "Cadastrar Operador",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@teste.com\",\n  \"password\": \"Operador@123\",\n  \"funcao\": \"analista\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Constelações",
      "item": [
        {
          "name": "Listar Constelações",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/constelacoes/",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Satélites",
      "item": [
        {
          "name": "Listar Satélites",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/satellites/",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Buscar Satélite por ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/satellites/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Cadastrar Satélite",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/satellites/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"con_id\": 1,\n  \"sat_codigo_prn\": 10,\n  \"sat_numero_svn\": 100,\n  \"sat_relogio_offset\": 0.0001,\n  \"sat_status\": \"operacional\"\n}"
            }
          }
        },
        {
          "name": "Atualizar Satélite",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/satellites/update/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"con_id\": 1,\n  \"sat_codigo_prn\": 10,\n  \"sat_numero_svn\": 100,\n  \"sat_relogio_offset\": 0.0002,\n  \"sat_status\": \"manutencao\"\n}"
            }
          }
        },
        {
          "name": "Deletar Satélite",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/satellites/delete/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Comandos",
      "item": [
        {
          "name": "Enviar Comando",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/commands",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"est_id\": 1,\n  \"sat_id\": 1,\n  \"cmd_tipo\": \"RESET\",\n  \"cmd_payload_binario\": \"SGVsbG8gV29ybGQ=\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Cobertura",
      "item": [
        {
          "name": "Cobertura Satélite",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cobertura/satelite/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Cobertura Constelação",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cobertura/constelacao/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    }
  ]
}
