# URL do projeto Supabase (Project Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key — NUNCA commitar; apenas no servidor (BFF).
# Obtenha em: Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Origens do front permitidas pelo CORS (CSV).
# Dev Vite padrão: http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
